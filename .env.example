# Copy the values from your Money Jars Supabase project:
# Supabase → Project Settings → API
#
# For local dev, copy this file to ".env" and fill in real values.
# For Vercel, set these in Settings → Environment Variables (do NOT commit real keys).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
